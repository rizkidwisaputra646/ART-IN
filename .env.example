# ==============================================================================
# ARTin - Environment Variables Template (Production & Development)
# Salin file ini menjadi .env.local untuk penggunaan lokal atau masukkan
# ke Settings Environment Variables di Vercel / penyedia hosting Anda.
# ==============================================================================

# 1. Supabase Project Configuration
# Diperoleh dari: Supabase Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here
# Atau gunakan format legacy anon key jika tersedia:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 2. Application URL & Identity
# Pada production, ganti dengan domain resmi Anda (contoh: https://artin.id)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ARTin
NEXT_PUBLIC_CITY_FOCUS=Bandar Lampung

# 3. Opsional: Service Role Key (Hanya jika dibutuhkan oleh background worker di luar Next.js)
# JANGAN PERNAH gunakan prefix NEXT_PUBLIC_ untuk key ini!
# SUPABASE_SERVICE_ROLE_KEY=
